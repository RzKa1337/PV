<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The updater store may contain the user's GitHub token: never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/updater.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/updater.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
